{
  "ConnectionStrings": {
    "cs": ""
  },
  "DetailedErrors": false,
  "Cors": {
    // Exact Flutter Web origins allowed to call this API (scheme + host + port, no trailing slash).
    // Required outside Development; startup fails fast when empty so production cannot silently
    // fall back to allowing every origin.
    "AllowedOrigins": []
  },
  "AccountDeletion": {
    // Public HTTPS origin of this API (no trailing slash). Used in emailed confirmation links.
    // Set in App Service settings as AccountDeletion__PublicBaseUrl.
    "PublicBaseUrl": "",
    "TokenLifetimeHours": 24,
    "SupportEmail": "johnpolis122@gmail.com"
  },
  "Smtp": {
    // When Host/FromAddress are empty, verification emails are logged and not sent.
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromDisplayName": "My Church"
  },
  "Swagger": {
    // Swagger is disabled in Production by default because it publishes the full API surface.
    "EnableInProduction": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
