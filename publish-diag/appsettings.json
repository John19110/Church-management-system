{
  "ConnectionStrings": {
    "cs": ""
  },
  "DetailedErrors": false,
  "Cors": {
    // Exact Flutter Web origins allowed to call this API (scheme + host + port, no trailing slash).
    // Required outside Development; startup fails fast when empty so production cannot silently
    // fall back to allowing every origin.
    "AllowedOrigins": []
  },
  "Swagger": {
    // Swagger is disabled in Production by default because it publishes the full API surface.
    "EnableInProduction": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
